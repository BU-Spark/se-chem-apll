generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  lessonNodeAttempts NodeAttempt[]
  nodeResponses      NodeResponse[]
  avatar             AvatarSetting?
  analytics          StudentAnalytics?
  surveyResponses    SurveyResponse[]
  badgeProgress      StudentBadge[]

  @@map("Student")
}

model AvatarSetting {
  id        String           @id @default(cuid())
  studentId String           @unique
  base      AvatarBase
  face      AvatarFace
  accessory AvatarAccessory?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student User @relation(fields: [studentId], references: [id])
}

enum AvatarBase {
  RUBY
  EMERALD
  SAPPHIRE
  AMETHYST
}

enum AvatarFace {
  SMILE
  SURPRISED
  MISCHIEF
}

enum AvatarAccessory {
  LEAF
  FEDORA
  PROPELLER
  NONE
}

// ---------------------------------------------------------------------------
// Courses & Enrollment
// ---------------------------------------------------------------------------

model Course {
  id                String          @id @default(cuid())
  code              String
  section           String?
  title             String
  description       String?
  createdByClerkId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  enrollments       Enrollment[]
  courseLessons     CourseLesson[]
  contacts          CourseContact[]

  @@unique([code, section])
  @@index([createdByClerkId])
}

model CourseContact {
  id        String            @id @default(cuid())
  courseId  String
  type      CourseContactType
  name      String
  email     String
  avatarUrl String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

enum CourseContactType {
  INSTRUCTOR
  CHECKER
}

model Enrollment {
  id        String     @id @default(cuid())
  studentId String
  courseId  String
  role      CourseRole @default(STUDENT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

enum CourseRole {
  STUDENT
  INSTRUCTOR
  CHECKER
}

// ---------------------------------------------------------------------------
// Lessons
// ---------------------------------------------------------------------------

model Lesson {
  id                String             @id @default(cuid())
  slug              String             @unique
  title             String
  summary           String
  description       String?
  thumbnailUrl      String?
  estimatedMinutes  Int?
  createdByClerkId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courseLessons     CourseLesson[]
  lessonNodes       LessonNode[]
  lessonNodeEdges   LessonNodeEdge[]
  progress          LessonProgress[]
  surveys           SurveyPrompt[]
  badgeRequirements BadgeRequirement[] @relation("BadgeLessonRequirement")

  @@index([createdByClerkId])
}

model CourseLesson {
  id                  String    @id @default(cuid())
  courseId            String
  lessonId            String
  openDate            DateTime?
  dueDate             DateTime?
  accessibleAfterDue  Boolean   @default(false)
  sortOrder           Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([courseId, lessonId])
  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// Nodes (reusable master templates)
// ---------------------------------------------------------------------------

model Node {
  id                  String           @id @default(cuid())
  title               String
  summary             String?
  videoUrl            String?
  muxPlaybackId       String?
  thumbnailUrl        String?
  estimatedMinutes    Int?
  tags                String[]         @default([])
  learningObjectives  String[]         @default([])
  createdByClerkId    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  checkpoints         NodeCheckpoint[]
  quizQuestions       QuizQuestion[]
  lessonNodes         LessonNode[]

  @@index([createdByClerkId])
}

// Timestamped QEV cue during the node video; holds one or more checkpoint questions.
model NodeCheckpoint {
  id                String               @id @default(cuid())
  nodeId            String
  sortOrder         Int
  timeOffsetSeconds Int
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  node              Node                 @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  questions         CheckpointQuestion[]

  @@unique([nodeId, sortOrder])
  @@unique([nodeId, timeOffsetSeconds])
}

model CheckpointQuestion {
  id             String   @id @default(cuid())
  checkpointId   String
  sortOrder      Int
  prompt         String
  // For multiple-choice: { type: "multipleChoice", choices: string[] } or legacy string[]
  // For short answer:    { type: "shortAnswer", answerMode: "exact"|"range", ... }
  options        Json
  correctIndices Int[]    @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  checkpoint NodeCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  responses  NodeResponse[]

  @@unique([checkpointId, sortOrder])
}

// Post-video (or foundational first-attempt) quiz bank; sampled via LessonNode.quizQuestionCount.
model QuizQuestion {
  id             String   @id @default(cuid())
  nodeId         String
  sortOrder      Int
  prompt         String
  options        Json
  correctIndices Int[]    @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  node      Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  responses NodeResponse[]

  @@unique([nodeId, sortOrder])
}

// ---------------------------------------------------------------------------
// LessonNode (per-lesson instance of a Node, with overrideable settings)
// ---------------------------------------------------------------------------

model LessonNode {
  id             String   @id @default(cuid())
  lessonId       String
  nodeId         String
  sortOrder      Int
  passingPercent Int
  quizQuestionCount Int
  isRequired     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson        Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  node          Node             @relation(fields: [nodeId], references: [id])
  attempts      NodeAttempt[]
  edgesAsSource LessonNodeEdge[] @relation("EdgeSource")
  edgesAsTarget LessonNodeEdge[] @relation("EdgeTarget")

  @@unique([lessonId, sortOrder])
}

// Directed edges between LessonNode instances within a lesson, forming a DAG roadmap
model LessonNodeEdge {
  id        String   @id @default(cuid())
  lessonId  String
  sourceId  String
  targetId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  source LessonNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target LessonNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// Progress & Attempts
// ---------------------------------------------------------------------------

model LessonProgress {
  id               String       @id @default(cuid())
  studentId        String
  lessonId         String
  status           LessonStatus @default(NOT_STARTED)
  startedAt        DateTime?
  completedAt      DateTime?
  percentComplete  Int          @default(0)
  lastGradePercent Float?
  lastGradePassed  Boolean?
  lastGradedAt     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  student User   @relation(fields: [studentId], references: [id])
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

enum LessonStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model NodeAttempt {
  id           String    @id @default(cuid())
  lessonNodeId String
  userId       String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  isPassing    Boolean?
  score        Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lessonNode LessonNode     @relation(fields: [lessonNodeId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id])
  responses  NodeResponse[]
}

model NodeResponse {
  id                   String   @id @default(cuid())
  attemptId            String
  checkpointQuestionId String?
  quizQuestionId       String?
  studentId            String
  selectedIndices      Int[]    @default([])
  rawAnswer            String?
  isCorrect            Boolean?
  createdAt            DateTime @default(now())

  attempt            NodeAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  checkpointQuestion CheckpointQuestion? @relation(fields: [checkpointQuestionId], references: [id], onDelete: Cascade)
  quizQuestion       QuizQuestion?       @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  student            User                @relation(fields: [studentId], references: [id])

  @@index([checkpointQuestionId])
  @@index([quizQuestionId])
}

// ---------------------------------------------------------------------------
// Badges
// ---------------------------------------------------------------------------

model Badge {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  description     String?
  category        BadgeCategory?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  requirements    BadgeRequirement[]
  studentProgress StudentBadge[]
  surveys         SurveyPrompt[]
}

enum BadgeCategory {
  SAFETY
  EQUIPMENT
  WASTE
  OTHER
}

model BadgeRequirement {
  id        String   @id @default(cuid())
  badgeId   String
  lessonId  String?
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  badge  Badge   @relation(fields: [badgeId], references: [id])
  lesson Lesson? @relation("BadgeLessonRequirement", fields: [lessonId], references: [id])
}

model StudentBadge {
  id        String      @id @default(cuid())
  studentId String
  badgeId   String
  status    BadgeStatus @default(LEARNING)
  awardedAt DateTime?
  score     Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  student User  @relation(fields: [studentId], references: [id])
  badge   Badge @relation(fields: [badgeId], references: [id])

  @@unique([studentId, badgeId])
}

enum BadgeStatus {
  LEARNING
  READY_FOR_ASSESSMENT
  READY_FOR_FINALIZATION
  COMPLETED
}

// ---------------------------------------------------------------------------
// Analytics & Surveys
// ---------------------------------------------------------------------------

model StudentAnalytics {
  id                     String   @id @default(cuid())
  studentId              String   @unique
  hoursLearning          Int      @default(0)
  badgesCompleted        Int      @default(0)
  questionsAnswered      Int      @default(0)
  averageAssessmentScore Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id])
}

model SurveyPrompt {
  id        String        @id @default(cuid())
  context   SurveyContext
  lessonId  String?
  badgeId   String?
  question  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lesson    Lesson?          @relation(fields: [lessonId], references: [id])
  badge     Badge?           @relation(fields: [badgeId], references: [id])
  responses SurveyResponse[]
}

model SurveyResponse {
  id          String   @id @default(cuid())
  promptId    String
  studentId   String
  rating      Int
  comment     String?
  submittedAt DateTime @default(now())

  prompt  SurveyPrompt @relation(fields: [promptId], references: [id])
  student User         @relation(fields: [studentId], references: [id])
}

enum SurveyContext {
  LESSON
  BADGE
}
